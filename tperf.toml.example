# Copy to tperf.toml. The file is the source of truth (no option flags).
#
#   tperf server tperf.toml
#   tperf client tperf.toml
#
# client_addr: servers bind this control socket; the client dials hostlist:port.
client_addr = "0.0.0.0:7777"
#
# test_addr: required. Host/IP must not be 0.0.0.0 or ::.
# The port is used on every server. If the host is an IP, it selects IPv4 vs IPv6;
# each server binds its own resolved address on that port.
test_addr = "srv1:9100"
network = "tcp"          # tcp | udp
payload_size = "100MiB"  # bytes per write; also 64KiB, 1e6, ...
workers = 10             # concurrent writers per destination
type = "pairs"           # pairs | mesh
hostlist = ["srv{1..4}"] # ellipsis may appear anywhere: rack-{1..3}.lab
tag = "run1"             # one sqlite file per run: ./run1.db (replaced if it exists)
